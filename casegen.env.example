# scm-casegen configuration — copy to casegen.env and edit.
#
#   cp casegen.env.example casegen.env
#   $EDITOR casegen.env
#   source casegen.env
#
# Every script here reads these as defaults; command-line flags still override
# them. Nothing outside this file should need editing for a new case.

# ---------------------------------------------------------------- the case --
# Initial time, YYYYMMDDHH. Drives the download, the ICs and the case names.
export CASEGEN_DATE=2022081500

# Forecast length in hours, and the forcing interval. GDAS analyses exist every
# 6 h, so FORCING_INTERVAL=6 is the usual choice.
export CASEGEN_LENGTH_HOURS=48
export CASEGEN_FORCING_INTERVAL=6

# Horizontal resolution of the IC/grid set. Used for the chgres target grid and
# written into the case_config namelists as C_RES.
export CASEGEN_CRES=768

# ------------------------------------------------------------ the SCM repo --
# Your CCPP-SCM checkout. UFS_case_gen.py is expected at
#   $CASEGEN_SCM_ROOT/scm/etc/scripts/UFS_case_gen.py
# and generated cases land in
#   $CASEGEN_SCM_ROOT/scm/data/processed_case_input/
#   $CASEGEN_SCM_ROOT/scm/etc/case_config/
export CASEGEN_SCM_ROOT=/path/to/your/ccpp-scm

# Physics suite, for the case_config namelists and the run command.
export CASEGEN_SUITE=SCM_GFS_v17_p8_ugwpv1

# This repo. Derived from where this file lives, so it is right whether the file
# is sourced from the repo, another directory, or inside a PBS job.
export CASEGEN_REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# -------------------------------------------------------------- the stations -
# CSV with one row per site. Required columns:
#   stid, 'lat [degrees]', 'lon [degrees]'
export CASEGEN_SITES_CSV=$CASEGEN_REPO/data/flux_site_metadata.csv

# Land-consistent coordinates written by check_land_mask.py and consumed by
# gen_scm_cases.py --locations.
export CASEGEN_LOCATIONS_CSV=$CASEGEN_REPO/data/scm_locations_${CASEGEN_DATE}.csv

# ------------------------------------------------------------------- paths --
# Scratch root. Everything generated lives underneath.
export CASEGEN_WORK=/glade/derecho/scratch/$USER/scm-casegen

# Raw GDAS download (atmf/sfcf + sfcanl)
export CASEGEN_FORCING_DIR=$CASEGEN_WORK/forcing/$CASEGEN_DATE
# Regional subset of the above (what case generation actually reads)
export CASEGEN_SUBSET_DIR=$CASEGEN_WORK/forcing_subset/$CASEGEN_DATE
# Assembled initial conditions -> UFS_case_gen --in_dir
export CASEGEN_IC_DIR=$CASEGEN_WORK/ICs/C${CASEGEN_CRES}_$CASEGEN_DATE
# Raw and tiled surface climatology (one-off per resolution)
export CASEGEN_CLIMO_SRC=$CASEGEN_WORK/fix/sfc_climo_src
export CASEGEN_CLIMO_DIR=$CASEGEN_WORK/fix/C${CASEGEN_CRES}_sfc_climo

# Static grid + orography for the target resolution. These do NOT depend on the
# case date; the EPIC UFS regression-test tree is a convenient source.
#
#   *** Do NOT point CASEGEN_IC_DIR at this directory. ***
#   Its sfc_data.tile*.nc are for an unrelated date. Only the grid, mosaic and
#   orography files are reused; sfc_data is rebuilt by scripts/make_ics.pbs.
export CASEGEN_STATIC_GRID=/glade/derecho/scratch/epicufsrt/ufs-weather-model/RT/NEMSfv3gfs/input-data-20260617/FV3_input_data${CASEGEN_CRES}/INPUT_L127_gfsv17

# UFS_UTILS checkout providing chgres_cube and sfc_climo_gen.
export CASEGEN_UFS_UTILS=/path/to/your/UFS_UTILS

# ------------------------------------------------------------ environments --
# The conda env created from CCPP-SCM's environment-ufscasegen.yml:
#   conda env create -f $CASEGEN_SCM_ROOT/environment-ufscasegen.yml
# The scripts call this interpreter directly without activating the env, so
# ESMFMKFILE must be set here; UFS_case_gen.py imports xesmf at module scope and
# dies without it.
export CASEGEN_PYTHON=/path/to/env_ufscasegen/bin/python
export ESMFMKFILE=/path/to/env_ufscasegen/lib/esmf.mk

# ------------------------------------------------------------------- batch --
export CASEGEN_ACCOUNT=YOUR_ACCOUNT
export CASEGEN_QUEUE=main
export CASEGEN_PRIORITY=premium
